    <scm>
        <developerConnection>scm:git:git@github.com:ibrahimgunduz34/blog-code-examples.git</developerConnection>
      <tag>mvn-release-1.0</tag>
  </scm>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
